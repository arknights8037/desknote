<UserControl x:Class="DestNote.Views.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DestNote"
             xmlns:views="clr-namespace:DestNote.Views"
             Background="Transparent"
             FontFamily="{StaticResource UiFont}">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE76B;"
                        Width="24" Height="24" FontSize="11" Click="Prev_Click"
                        AutomationProperties.Name="上一页" ToolTip="上一页"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                    <Ellipse x:Name="PageDot1" Width="4.5" Height="4.5" Margin="2"
                             Fill="{DynamicResource AccentBrush}"/>
                    <Ellipse x:Name="PageDot2" Width="4.5" Height="4.5" Margin="2"
                             Fill="{DynamicResource PaperLineBrush}"/>
                    <Ellipse x:Name="PageDot3" Width="4.5" Height="4.5" Margin="2"
                             Fill="{DynamicResource PaperLineBrush}"/>
                </StackPanel>
                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE76C;"
                        Width="24" Height="24" FontSize="11" Click="Next_Click"
                        AutomationProperties.Name="下一页" ToolTip="下一页"/>
            </StackPanel>
            <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;"
                    Width="24" Height="24" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,4,8,0" Opacity="0.55" Click="More_Click"
                    AutomationProperties.Name="更多" ToolTip="更多"/>
        </Grid>

        <Grid Grid.Row="1" x:Name="PagesHost" ClipToBounds="True">
            <Grid x:Name="NotesPage">
                <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,0,4">
                    <StackPanel>
                    <ItemsControl x:Name="NotesList" Margin="16,1,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:NoteItem}">
                                <Border x:Name="Row" Background="Transparent" CornerRadius="6" Margin="0,1" Padding="2,0">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="删除" Click="DeleteNoteMenu_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="CheckButton" Width="24" Height="30" Padding="0"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                FocusVisualStyle="{x:Null}" Click="ToggleNote_Click"
                                                AutomationProperties.Name="切换完成状态">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Grid Background="Transparent">
                                                        <Ellipse x:Name="Circle" Width="15" Height="15"
                                                                 Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.2"
                                                                 Fill="Transparent"/>
                                                        <TextBlock x:Name="Tick" Text="&#xE73E;"
                                                                   FontFamily="{StaticResource IconFont}" FontSize="7"
                                                                   Foreground="White" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Circle" Property="Stroke"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter TargetName="Circle" Property="Fill"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="Circle" Property="Stroke"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <TextBlock x:Name="NoteText" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                   FontSize="12.3" LineHeight="19" Margin="3,5,4,5"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="DeferText" Text="{Binding DeferLabel}" FontSize="8.2"
                                                       Foreground="{DynamicResource FaintBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <Button x:Name="DeleteButton" Style="{StaticResource TinyIconButton}"
                                                    Content="&#xE711;" FontSize="8" Opacity="0.14" Click="DeleteNote_Click"
                                                    AutomationProperties.Name="删除便签" ToolTip="删除"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        <Setter TargetName="DeleteButton" Property="Opacity" Value="0.75"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="NoteText" Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                                        <Setter TargetName="Row" Property="Opacity" Value="0.68"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCollected}" Value="True">
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Row" Property="BorderThickness" Value="2,0,0,0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="CommandHintText" Margin="18,2,10,0" FontSize="8.3"
                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <Grid Margin="16,4,12,10" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddNoteButton" Style="{StaticResource IconButton}" Width="24" Height="24"
                                Padding="0" Content="&#xE710;" FontSize="10" IsEnabled="False"
                                Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                AutomationProperties.Name="添加便签" Click="AddNote_Click" ToolTip="添加"/>
                        <Grid Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center">
                            <TextBox x:Name="NoteInput" FontSize="12.3" MaxLength="400"
                                     AutomationProperties.Name="新便签"
                                     TextChanged="NoteInput_TextChanged"
                                     GotKeyboardFocus="Input_FocusChanged"
                                     LostKeyboardFocus="Input_FocusChanged"
                                     PreviewKeyDown="NoteInput_PreviewKeyDown"/>
                            <TextBlock x:Name="NotePlaceholder" Text="写一行…" FontSize="12.3"
                                       Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="BillsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="BillsScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,0,3">
                    <StackPanel>
                        <StackPanel x:Name="BillsListPanel" Margin="16,1,8,1"/>

                        <StackPanel Margin="16,4,12,7">
                            <TextBlock x:Name="AmountPreviewText" Text="" FontSize="8.5"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"
                                       Margin="0,0,27,1" Visibility="Collapsed"/>
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="CategoryButton" Grid.Column="0" Style="{StaticResource GhostButton}"
                                        BorderThickness="0" Padding="3,3" Click="Category_Click"
                                        AutomationProperties.Name="选择类别">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="CategoryDot" Width="5" Height="5" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CategoryText" Text="餐饮" FontSize="9.3" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="2,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="¥" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="AmountInput" FontFamily="{StaticResource NumberFont}"
                                                 FontSize="15" FontWeight="SemiBold" MaxLength="40"
                                                 AutomationProperties.Name="金额"
                                                 PreviewTextInput="AmountInput_PreviewTextInput"
                                                 TextChanged="AmountInput_TextChanged"
                                                 GotKeyboardFocus="Input_FocusChanged"
                                                 LostKeyboardFocus="Input_FocusChanged"
                                                 PreviewKeyDown="AmountInput_PreviewKeyDown"/>
                                        <TextBlock x:Name="AmountPlaceholder" Text="0" FontFamily="{StaticResource NumberFont}"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}"
                                                   IsHitTestVisible="False" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Column="2" Margin="2,0,4,0" VerticalAlignment="Center">
                                    <TextBox x:Name="BillNoteInput" FontSize="10.5" MaxLength="80"
                                             AutomationProperties.Name="账单备注"
                                             TextChanged="BillNoteInput_TextChanged"
                                             GotKeyboardFocus="Input_FocusChanged"
                                             LostKeyboardFocus="Input_FocusChanged"
                                             PreviewKeyDown="BillNoteInput_PreviewKeyDown"/>
                                    <TextBlock x:Name="BillNotePlaceholder" Text="备注" FontSize="10.5"
                                               Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Button x:Name="AddBillButton" Grid.Column="3" Style="{StaticResource IconButton}"
                                        Width="24" Height="24" Padding="0" Content="&#xE710;" FontSize="10"
                                        IsEnabled="False" Foreground="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" AutomationProperties.Name="记一笔"
                                        Click="AddBill_Click" ToolTip="记一笔"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" BorderBrush="{DynamicResource PaperLineBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="16,5,14,8">
                        <TextBlock x:Name="TodayStatsText" Text="今日 ¥0.00" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TodayCountText" Text="0 笔" HorizontalAlignment="Right" FontSize="9"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>
                </Border>
            </Grid>

            <views:PlanPage x:Name="PlanPage" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
