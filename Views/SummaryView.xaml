<UserControl x:Class="DestNote.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DestNote.Controls"
             Background="Transparent"
             FontFamily="{StaticResource UiFont}">
    <Grid Margin="20,2,20,0" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,10" Focusable="False">
            <StackPanel>
                <Grid Margin="0,0,0,3">
                    <Button x:Name="PrevButton" HorizontalAlignment="Left" Style="{StaticResource TinyIconButton}"
                            Content="&#xE76B;" Click="Prev_Click" AutomationProperties.Name="上一期" ToolTip="上一期"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="PeriodCaption" FontSize="10.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="BackCurrent" Content="回到本周" Style="{StaticResource TextButton}"
                                FontSize="8.5" Padding="3,0" HorizontalAlignment="Center" Visibility="Collapsed"
                                Click="BackCurrent_Click"/>
                    </StackPanel>
                    <Button x:Name="NextButton" HorizontalAlignment="Right" Style="{StaticResource TinyIconButton}"
                            Content="&#xE76C;" Click="Next_Click" AutomationProperties.Name="下一期" ToolTip="下一期"/>
                </Grid>

                <Grid Margin="0,3,0,9">
                    <StackPanel>
                        <TextBlock x:Name="PeriodKindText" Text="本周支出" FontSize="9.5"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="TotalText" Text="¥0.00" FontFamily="{StaticResource NumberFont}"
                                   FontSize="28" FontWeight="SemiBold" Margin="0,-2,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <TextBlock x:Name="CountText" Text="0 笔" FontSize="9" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="AverageText" Text="日均 ¥0.00" FontSize="9" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="CompareText" Text="上期无记录" FontSize="8.8" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource PaperLineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,9,12,7" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="ChartTitle" Text="每日支出" FontSize="10" FontWeight="SemiBold"/>
                            <Button Content="导出本期" Style="{StaticResource TextButton}" FontSize="8.8"
                                    HorizontalAlignment="Right" Padding="3,0" Click="Export_Click"
                                    ToolTip="导出当前汇总周期为 CSV"/>
                        </Grid>
                        <controls:BarChart x:Name="Chart" Height="126" Margin="0,2,0,0"
                                           AutomationProperties.Name="支出柱状图"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,1">
                    <TextBlock Text="钱花在哪" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CategoryHintText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="8.8" Foreground="{DynamicResource FaintBrush}"/>
                </Grid>
                <UniformGrid x:Name="CategoryPanel" Columns="2" Margin="0,3,0,0"/>

                <Border Background="{DynamicResource PaperDeepBrush}" CornerRadius="8" Padding="9,7"
                        Margin="0,8,0,4">
                    <TextBlock x:Name="InsightText" FontSize="9.5" TextWrapping="Wrap" LineHeight="15"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Border>
                <TextBlock x:Name="FootNote" FontSize="8.3" Foreground="{DynamicResource FaintBrush}"
                           Text="周从周一开始 · 月按自然月统计" Margin="0,1,0,4"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
