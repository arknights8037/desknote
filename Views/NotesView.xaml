<UserControl x:Class="DestNote.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DestNote"
             Background="Transparent"
             FontFamily="{StaticResource UiFont}">
    <Grid Margin="20,5,20,0" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,9">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="要做的事" FontSize="16.5" FontWeight="SemiBold"/>
                <Border x:Name="CountBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"
                        Padding="8,2.5" Margin="9,1,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CountBadgeText" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentDeepBrush}"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="SublineText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="9.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Border Grid.Row="1" Height="42" Background="{DynamicResource CardStrongBrush}"
                BorderBrush="{DynamicResource PaperLineBrush}" BorderThickness="1" CornerRadius="9"
                Margin="0,0,0,9">
            <Grid Margin="11,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBox x:Name="QuickInput" FontSize="12.5" MaxLength="400" TextChanged="QuickInput_TextChanged"
                             AutomationProperties.Name="新便签" PreviewKeyDown="QuickInput_PreviewKeyDown"/>
                    <TextBlock x:Name="QuickPlaceholder" Text="写下一件要做的事…" FontSize="12.5"
                               Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="0,0,0,1"/>
                </Grid>
                <Button x:Name="AddNoteButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Width="30" Height="30" Padding="0" Click="AddNote_Click" ToolTip="添加便签（Enter）"
                        AutomationProperties.Name="添加便签"
                        IsEnabled="False">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AllFilter" Content="全部" GroupName="NoteFilter" IsChecked="True"
                             Style="{StaticResource SectionTab}" Padding="8,3" FontSize="10.5"
                             Checked="Filter_Checked" Tag="all"/>
                <RadioButton x:Name="OpenFilter" Content="待办" GroupName="NoteFilter"
                             Style="{StaticResource SectionTab}" Padding="8,3" FontSize="10.5"
                             Checked="Filter_Checked" Tag="open"/>
                <RadioButton x:Name="DoneFilter" Content="已完成" GroupName="NoteFilter"
                             Style="{StaticResource SectionTab}" Padding="8,3" FontSize="10.5"
                             Checked="Filter_Checked" Tag="done"/>
            </StackPanel>
            <TextBlock x:Name="FilterHintText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="9" Foreground="{DynamicResource FaintBrush}"/>
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,8" Focusable="False">
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:NoteItem}">
                            <Border x:Name="Row" Background="Transparent" CornerRadius="7" Margin="0,1" Padding="3,0">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="编辑便签" Click="EditNoteMenu_Click"/>
                                        <MenuItem Header="删除便签" Click="DeleteNoteMenu_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" x:Name="CheckButton" Width="25" Height="28" Padding="0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" Click="ToggleNote_Click"
                                            AutomationProperties.Name="切换完成状态" ToolTip="切换完成状态">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="Circle" Width="16" Height="16"
                                                             Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.2"
                                                             Fill="Transparent"/>
                                                    <TextBlock x:Name="Tick" Text="&#xE73E;"
                                                               FontFamily="{StaticResource IconFont}" FontSize="8"
                                                               Foreground="White" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Circle" Property="Stroke"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="Circle" Property="Fill"
                                                                Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter TargetName="Circle" Property="Fill"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="Circle" Property="Stroke"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Grid Grid.Column="1" Margin="2,5,4,5">
                                        <TextBlock x:Name="NoteText" Text="{Binding Text}" TextWrapping="Wrap"
                                                   FontSize="12.5" LineHeight="19" VerticalAlignment="Center"
                                                   MouseLeftButtonDown="NoteText_MouseLeftButtonDown"
                                                   ToolTip="双击编辑"/>
                                        <TextBox x:Name="EditBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12.5" TextWrapping="Wrap" Visibility="Collapsed"
                                                 Background="{DynamicResource CardStrongBrush}" Padding="4,2"
                                                 PreviewKeyDown="EditBox_PreviewKeyDown"
                                                 LostKeyboardFocus="EditBox_LostKeyboardFocus"
                                                 IsVisibleChanged="EditBox_IsVisibleChanged"/>
                                    </Grid>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock x:Name="TimeText" Text="{Binding CreatedHint}" FontSize="8.5"
                                                   Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,3,0"/>
                                        <Button x:Name="DeleteButton" Style="{StaticResource TinyIconButton}"
                                                Content="&#xE74D;" Opacity="0.32" Click="DeleteNote_Click"
                                                AutomationProperties.Name="删除便签" ToolTip="删除"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    <Setter TargetName="DeleteButton" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="NoteText" Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                                    <Setter TargetName="Row" Property="Opacity" Value="0.68"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter TargetName="NoteText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="0,0,0,50" IsHitTestVisible="False">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyGlyph" Text="&#xE70B;" FontFamily="{StaticResource IconFont}"
                               FontSize="17" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="纸条还是空的" FontSize="12.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,2"/>
                <TextBlock x:Name="EmptyHint" Text="在上面写下一件小事，按 Enter 收好" FontSize="9.5"
                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
