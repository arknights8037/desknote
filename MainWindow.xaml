<Window x:Class="DestNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DestNote.Views"
        Title="轻笺"
        Width="332" Height="380" MinWidth="300" MinHeight="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Icon="Assets/app.ico" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource InkBrush}" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="SettingsLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,13,0,5"/>
        </Style>
        <Style x:Key="SettingsNote" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="13"/>
        </Style>
        <Style x:Key="ToastUndoButton" TargetType="{x:Type Button}" BasedOn="{StaticResource TextButton}">
            <Setter Property="Foreground" Value="#FFF0C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="9,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="Paper" Margin="15,13,21,21" Background="{DynamicResource PaperBrush}"
                BorderBrush="{DynamicResource PaperLineBrush}" BorderThickness="1" CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270" Color="#3A3427" Opacity="0.30"/>
            </Border.Effect>
            <Grid x:Name="PaperGrid" ClipToBounds="True">
                <Rectangle IsHitTestVisible="False" Opacity="0.04">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#553F4439">
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry Center="1.2,1.2" RadiusX="0.5" RadiusY="0.5"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid x:Name="FullSurface">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="31"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,23,12,0" Background="Transparent"
                          MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Width="23" Height="23" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="笺" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource UiFont}"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="轻笺" FontSize="14" FontWeight="SemiBold" LineHeight="17"/>
                                <TextBlock x:Name="DateText" Text="10月26日 · 周日" FontSize="8.8"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                                    AutomationProperties.Name="钉在桌面" Click="PinButton_Click" ToolTip="钉在桌面"/>
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                                    AutomationProperties.Name="设置" Margin="1,0,0,0" Click="SettingsButton_Click" ToolTip="设置"/>
                            <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="&#xE921;"
                                    AutomationProperties.Name="收进托盘" Margin="1,0,0,0" Click="MinimizeButton_Click" ToolTip="收进托盘"/>
                            <Button x:Name="CloseButton" Style="{StaticResource CloseIconButton}" Content="&#xE8BB;"
                                    AutomationProperties.Name="收进托盘" Margin="1,0,0,0" Click="CloseButton_Click" ToolTip="收进托盘"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,7,20,0" VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <RadioButton x:Name="NotesTab" Content="便签" GroupName="MainTab" IsChecked="True"
                                         Style="{StaticResource PaperTab}" Checked="Tab_Checked" Tag="notes"/>
                            <RadioButton x:Name="BillsTab" Content="账本" GroupName="MainTab"
                                         Style="{StaticResource PaperTab}" Checked="Tab_Checked" Tag="bills"/>
                        </StackPanel>
                        <TextBlock x:Name="TabHintText" Text="纸上两件事" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="8.5"
                                   Foreground="{DynamicResource FaintBrush}"/>
                    </Grid>
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Margin="20,0,20,0"
                            Background="{DynamicResource PaperLineBrush}" Opacity="0.55"/>

                    <Grid Grid.Row="2" ClipToBounds="True">
                        <views:NotesView x:Name="NotesPage"/>
                        <views:BillsView x:Name="BillsPage" Visibility="Collapsed"/>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource PaperLineBrush}" BorderThickness="0,1,0,0">
                        <Grid Margin="20,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SaveDot" Width="5" Height="5" Fill="{DynamicResource AccentBrush}"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="SaveStatusText" Text="自动保存" FontSize="8.4"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Ctrl + Alt + N" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="8.1" Foreground="{DynamicResource FaintBrush}"/>
                        </Grid>
                    </Border>
                </Grid>

                <views:CardView x:Name="CardSurface" Visibility="Collapsed"/>

                <!-- Settings sheet -->
                <Grid x:Name="SettingsOverlay" Grid.RowSpan="4" Panel.ZIndex="40" Visibility="Collapsed"
                      Background="{DynamicResource PaperOverlayBrush}">
                    <Grid Margin="20,20,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="让这张纸更顺手" FontSize="8.8" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button x:Name="CloseSettingsButton" Style="{StaticResource IconButton}"
                                    Content="&#xE8BB;" AutomationProperties.Name="关闭设置"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Click="CloseSettings_Click" ToolTip="关闭设置"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="这张纸" Style="{StaticResource SettingsLabel}" Margin="0,5,0,2"/>
                                <CheckBox x:Name="PinSwitch" Style="{StaticResource Switch}" Content="钉在桌面（始终置顶）"
                                          Checked="PinSwitch_Changed" Unchecked="PinSwitch_Changed"/>
                                <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="开机时静默启动"
                                          Margin="0,7,0,0" Checked="StartupSwitch_Changed"
                                          Unchecked="StartupSwitch_Changed"/>
                                <CheckBox x:Name="CardModeSwitch" Style="{StaticResource Switch}" Content="小卡片模式"
                                          Margin="0,7,0,0" Checked="CardModeSwitch_Changed"
                                          Unchecked="CardModeSwitch_Changed"/>

                                <Grid Margin="0,11,0,0">
                                    <TextBlock Text="纸张颜色" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="ThemePanel" Orientation="Horizontal"
                                                HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Style="{StaticResource PaperSeparator}" Margin="0,13,0,0"/>

                                <TextBlock Text="数据" Style="{StaticResource SettingsLabel}" Margin="0,8,0,4"/>
                                <TextBlock x:Name="DataPathText" FontSize="8.1" Foreground="{DynamicResource FaintBrush}"
                                           TextWrapping="Wrap" LineHeight="12"/>
                                <WrapPanel Margin="0,7,0,0">
                                    <Button Content="打开数据文件夹" Style="{StaticResource GhostButton}"
                                            FontSize="9" Padding="8,4" Margin="0,0,5,5" Click="OpenDataFolder_Click"/>
                                    <Button Content="备份数据" Style="{StaticResource GhostButton}"
                                            FontSize="9" Padding="8,4" Margin="0,0,5,5" Click="BackupData_Click"/>
                                    <Button Content="导出全部账单" Style="{StaticResource GhostButton}"
                                            FontSize="9" Padding="8,4" Margin="0,0,5,5" Click="ExportAllBills_Click"/>
                                </WrapPanel>
                                <Button x:Name="ClearDoneButton" Content="清空已完成的便签" Style="{StaticResource TextButton}"
                                        Foreground="{DynamicResource DangerBrush}" FontSize="9" Padding="0,3"
                                        HorizontalAlignment="Left" Click="ClearDone_Click"/>

                                <Border Style="{StaticResource PaperSeparator}" Margin="0,8,0,0"/>

                                <TextBlock Text="随手呼出" Style="{StaticResource SettingsLabel}" Margin="0,8,0,4"/>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10,7">
                                    <Grid>
                                        <TextBlock Text="呼出轻笺并写便签" FontSize="9" Foreground="{DynamicResource AccentDeepBrush}"/>
                                        <TextBlock Text="Ctrl + Alt + N" HorizontalAlignment="Right" FontSize="9"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentDeepBrush}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="关闭或最小化会收进托盘，程序仍在后台运行；从托盘菜单退出。所有数据只保存在本机。"
                                           Style="{StaticResource SettingsNote}" Margin="0,10,0,0"/>
                                <TextBlock Text="轻笺 1.4  ·  Made for a lighter day" Style="{StaticResource SettingsNote}"
                                           Margin="0,9,0,2"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Toast -->
                <Grid x:Name="ToastHost" Grid.RowSpan="4" Panel.ZIndex="70" VerticalAlignment="Bottom"
                      HorizontalAlignment="Center" Margin="18,0,18,41" Visibility="Collapsed" Opacity="0">
                    <Border Background="{DynamicResource InkBrush}" CornerRadius="8" Padding="12,7"
                            BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.22"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToastText" Text="" FontSize="10.2" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PaperBrush}" TextWrapping="Wrap" MaxWidth="270"/>
                            <Button x:Name="ToastUndoButton" Content="撤销" Style="{StaticResource ToastUndoButton}"
                                    Visibility="Collapsed" Click="ToastUndo_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Washi tape -->
        <Grid x:Name="TapeDecor" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" IsHitTestVisible="False">
            <Border Width="98" Height="21" CornerRadius="2" Background="{DynamicResource TapeBrush}" Opacity="0.62"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="-2.4"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.15"/>
                </Border.Effect>
                <Border BorderBrush="#44FFFFFF" BorderThickness="0,1,0,1"/>
            </Border>
        </Grid>
    </Grid>
</Window>
